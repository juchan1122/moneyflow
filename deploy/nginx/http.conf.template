# http 모드: 도메인 · 인증서가 없을 때 (공인 IP 로 접속해서 확인용)
# PWA 설치 · Service Worker · 푸시는 HTTPS 에서만 되므로 이 모드는 잠깐만 쓴다
# ${SERVER_NAME} 은 컨테이너가 켜질 때 .env 값으로 바뀜 (nginx 공식 이미지 templates 기능)
server {
    listen 80 default_server;
    server_name ${SERVER_NAME};

    # 인증서를 처음 받을 때 Let's Encrypt 가 확인하러 오는 주소
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/snippets/app.conf;
}
