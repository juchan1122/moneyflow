# 운영 서버 비밀값 · 설정. 서버에서 이 파일을 .env 로 복사하고 값을 채운다
#   cp .env.example .env && nano .env
# .env 는 저장소에 올리지 않는다 (.gitignore)

# ---------- 주소 ----------
# 도메인이 없으면: 서버 공인 IP 를 sslip.io 이름으로 (IP 가 158.180.1.2 이면 158-180-1-2.sslip.io)
#   → 도메인을 사지 않아도 HTTPS 인증서를 받을 수 있음. 나중에 도메인을 사면 이 값만 바꾸고 인증서를 다시 받음
SERVER_NAME=158-180-1-2.sslip.io

# http: 인증서 받기 전 / https: issue-cert.sh 로 인증서를 받은 뒤
NGINX_MODE=http
# https 모드일 때는 https 로 바꿔야 인증서 자동 갱신(certbot)이 켜짐
COMPOSE_PROFILES=
# 로그인 쿠키를 HTTPS 에서만 보낼지. http 모드에서는 false, https 모드에서는 true
COOKIE_SECURE=false

# Let's Encrypt 만료 안내 메일을 받을 주소 (인증서 받을 때만 씀)
CERT_EMAIL=

HTTP_PORT=80
HTTPS_PORT=443

# ---------- DB ----------
# 비밀번호는 길게 아무렇게나: openssl rand -base64 24
DB_USERNAME=moneyflow
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------- 메모리 (서버 사양에 맞게) ----------
JAVA_OPTS=-Xms256m -Xmx768m
MYSQL_BUFFER_POOL=256M
